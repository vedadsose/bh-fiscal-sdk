{
  "name": "bh-fiscal-sdk",
  "version": "0.1.1",
  "description": "",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "bh-fiscal-emulator": "lib/emulator/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./emulator": {
      "types": "./lib/emulator/index.d.ts",
      "default": "./lib/emulator/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "emulator": [
        "lib/emulator/index.d.ts"
      ]
    }
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.emulator.json",
    "prepare": "npm run build",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "test": "jest .",
    "emulator": "node lib/emulator/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedadsose/bh-fiscal-sdk.git"
  },
  "author": "Vedad Sose <vedadsose@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vedadsose/bh-fiscal-sdk/issues"
  },
  "homepage": "https://github.com/vedadsose/bh-fiscal-sdk#readme",
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@types/mustache": "^4.1.2",
    "jest": "^29.4.1",
    "msw": "^1.0.0",
    "nodemon": "^2.0.15",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.4.0",
    "typescript": "^4.5.4"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "date-fns": "^2.27.0",
    "fast-xml-parser": "^4.1.1",
    "mustache": "^4.2.0"
  }
}
